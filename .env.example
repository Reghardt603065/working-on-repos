# Required PostgreSQL connection string (Neon recommended for Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Required Auth.js secret; generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Optional GitHub OAuth
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Optional Adzuna API (Remotive and Arbeitnow require no key)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
ADZUNA_COUNTRY="za"

# Protects the scheduled job-ingestion route
CRON_SECRET="replace-with-another-random-secret"

# Local URL. Replace with the Vercel production URL when deployed.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
